<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is permitted ONLY for the local development backend.
  Everything else must be HTTPS, so shipping a stray http:// URL fails loudly
  instead of silently sending credentials and payloads in the clear.
  127.0.0.1 / localhost cover `adb reverse`; 10.0.2.2 is the emulator host alias.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>