<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replacement for android:allowBackup="false": exclude every
     domain from both cloud backup and device-to-device transfer, matching
     the pre-12 behaviour (session tokens must never leave the device via
     backup channels). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
