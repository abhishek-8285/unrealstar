<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#151224"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#3D3766" />

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnCloseMushaira"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_mushaira"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/generate_stylized_poetic_verses_for"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseMushaira"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/watch_close"
            android:textColor="@color/text_muted"
            android:textSize="18sp" />
    </RelativeLayout>

    <!-- Language Selector Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/language_of_poem"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPoemLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_translucent"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/poem_language"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Poetry Styles (Horizontal Scroll) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutPoemStyles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipLovePoem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_active"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/chip_love_poem"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipGhazal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/chip_ghazal"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFunnyPoem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/chip_funny_poem"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipOde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/chip_ode"
                android:textColor="@color/text_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipShayari"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_translucent"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/chip_shayari"
                android:textColor="@color/text_white"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Prompt Input Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#1E1A33"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#252A40"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etPoemPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/mushaira_prompt_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="13sp"
            android:importantForAutofill="no" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Generate Verse Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateVerse"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_chip_active"
        android:text="@string/generate_verse"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <!-- Verse Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVersePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#2A1B4E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#6C5CE7"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_2"
                android:textColor="#A29BFE"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGeneratedVerse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/generated_verse"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:fontFamily="serif" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvPoemAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/tvPoemTag"
                    android:text="@string/poem_author"
                    android:textColor="#A29BFE"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPoemTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/poem_tag"
                    android:textColor="#FDCB6E"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Bar for AI Mushaira (Listen, Copy, Share) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListenPoem"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_chip_translucent"
            android:text="@string/listen_poem"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCopyPoem"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_chip_translucent"
            android:text="@string/copy_poem"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSharePoem"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_translucent"
            android:text="@string/share_poem"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Post to Feed Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPostPoemToFeed"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_gradient_orange"
        android:text="@string/post_poem_to_feed"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />
</LinearLayout>
