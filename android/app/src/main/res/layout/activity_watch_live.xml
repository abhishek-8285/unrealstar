<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/renderer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvHostName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/watch_host" />

        <TextView
            android:id="@+id/btnFollowHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_feed_follow_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="+ Follow"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tvViewers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="44dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:text="@string/watch_close"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- PK Battle Bar (Dual-colored Red vs Blue with Points & Timer) -->
    <LinearLayout
        android:id="@+id/layoutPkBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:paddingHorizontal="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_translucent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/tvPkHostAPoints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#2196F3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="🔵 Blue: 0"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvPkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pk_edge_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/text_white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="⚔️ PK BATTLE"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/tvPkHostBPoints"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="#F44336"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="0 :Red 🔴"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Container: Chat messages + Input / Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Gift & VIP Entrance Floating Banner -->
        <TextView
            android:id="@+id/tvGiftBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_topup_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="@color/background_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="✨ VIP Star_1001 entered the room!" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/secondary"
            android:textSize="12sp"
            android:text="@string/watch_connecting" />

        <!-- Chat Stream (up to 160dp) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none" />

        <!-- Input & Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etChatInput"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_translucent"
                android:hint="@string/chat_placeholder"
                android:imeOptions="actionSend"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSendChat"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_translucent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="Send"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Wheel Minigame Button -->
            <TextView
                android:id="@+id/btnToggleWheel"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_translucent"
                android:gravity="center"
                android:text="🎡"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <!-- Send Gift Button -->
            <TextView
                android:id="@+id/btnToggleGifts"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_chip_translucent"
                android:gravity="center"
                android:text="🎁"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
