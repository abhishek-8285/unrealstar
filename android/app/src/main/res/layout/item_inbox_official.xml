<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp">

    <!-- Illustration, only present on some notices. -->
    <ImageView
        android:id="@+id/ivNoticeImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/bg_inbox_comments"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/cardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_inbox_official_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Status Alert!" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoticeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_inbox_official_card"
        android:lineSpacingExtra="3dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="#C9C9E4"
        android:textSize="13sp"
        tools:text="Spend 1 more coins to keep your L1-Rookie next month." />

    <TextView
        android:id="@+id/tvNoticeTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#6E6E8C"
        android:textSize="11sp"
        tools:text="2026/09/26 01:36" />
</LinearLayout>
