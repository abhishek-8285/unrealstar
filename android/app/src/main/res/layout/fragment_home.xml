<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- One moment per screen, swiped vertically. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!--
      Header floats over the video, as in the reference. The top scrim keeps it
      readable over bright frames; MainActivity has already inset this container
      below the status bar.
    -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feed_top_scrim"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivShield"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/content_shield"
            android:src="@drawable/ic_feed_shield"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_feed_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFollowed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feed_tab_followed"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvForYou"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/ivShield"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvForYou"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="22dp"
            android:text="@string/feed_tab_for_you"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivSearch"
            app:layout_constraintStart_toEndOf="@id/tvFollowed"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/viewIndicatorFollowed"
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFFFF"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/tvFollowed"
            app:layout_constraintStart_toStartOf="@id/tvFollowed"
            app:layout_constraintTop_toBottomOf="@id/tvFollowed" />

        <View
            android:id="@+id/viewIndicator"
            android:layout_width="26dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="#FFFFFFFF"
            app:layout_constraintEnd_toEndOf="@id/tvForYou"
            app:layout_constraintStart_toStartOf="@id/tvForYou"
            app:layout_constraintTop_toBottomOf="@id/tvForYou" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
      Shown instead of the feed. The copy changes per cause so a dropped
      connection never reads as "nobody is live right now".
    -->
    <LinearLayout
        android:id="@+id/stateBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStateBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/retry"
            android:textColor="@color/text_white"
            app:backgroundTint="@color/primary"
            app:cornerRadius="22dp" />

    </LinearLayout>

</FrameLayout>