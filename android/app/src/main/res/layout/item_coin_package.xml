<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="#1A1829"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#2F3254"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Bonus tag if any -->
        <TextView
            android:id="@+id/tvCoinBonusTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feed_pill_gold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="+15 BONUS"
            android:textColor="@color/text_white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_me_diamond"
            app:tint="@color/level_gold" />

        <TextView
            android:id="@+id/tvCoinsAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="150" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coins"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuyPackage"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_chip_active"
            android:padding="0dp"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            tools:text="₹99" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
