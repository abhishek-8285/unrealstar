<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Header: avatar badge, scrollable tabs, leaderboard trophy. -->
    <LinearLayout
        android:id="@+id/liveHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAvatarBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_live_avatar"
            android:gravity="center"
            android:text="@string/live_avatar_initial"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/tabScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/search"
            android:padding="4dp"
            android:src="@drawable/ic_feed_search"
            app:tint="@color/text_white" />

        <ImageView
            android:id="@+id/btnRank"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/live_rank"
            android:padding="3dp"
            android:src="@drawable/ic_live_trophy" />
    </LinearLayout>

    <!-- Promoted slides, matching the reference carousel above the wall. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBanners"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/liveHeader"
        tools:itemCount="3"
        tools:listitem="@layout/item_live_banner" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRooms"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvBanners"
        tools:itemCount="6"
        tools:listitem="@layout/item_live_room"
        tools:spanCount="2" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="@string/rooms_empty"
        android:textColor="@color/text_muted"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvRooms"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvRooms" />

</androidx.constraintlayout.widget.ConstraintLayout>