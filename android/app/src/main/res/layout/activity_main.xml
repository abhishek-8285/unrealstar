<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Tab content lives here; MainActivity swaps the fragment inside it. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:elevation="12dp"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_menu" />

    <!--
      Kept outside BottomNavigationView because that view tints every icon it
      owns, which would flatten this gradient circle to one colour.
      Anchored to the bar's TOP edge with a negative margin so it overhangs.
      Anchoring to the top edge (not centring on the bar) keeps it correctly
      placed once system-bar inset padding is added to bottomNav.

      elevation must exceed bottomNav's 12dp, otherwise the bar paints over
      the button and clips it in half.
    -->
    <ImageButton
        android:id="@+id/btnCreate"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="-36dp"
        android:background="@drawable/bg_create_button"
        android:contentDescription="@string/start_broadcast"
        android:elevation="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>