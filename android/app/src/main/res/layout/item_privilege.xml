<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivPrivilegeIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_me_pill_outline"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_me_crown"
        app:tint="@color/level_gold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrivilegeLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_me_pill_gradient"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="Lv 25"
                android:textColor="@color/text_white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrivilegeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text_white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Exclusive Wealth Avatar Badge" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrivilegeDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="Golden level crest displayed beside user nickname" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPrivilegeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Unlocked"
        android:textColor="@color/disclaimer_green"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
