# Copy to .env and fill in. Read by deploy.sh (not committed).

# Shared secret with the API (CAMSTAR_TURN_SECRET). Generate once:
#   openssl rand -hex 32
TURN_SECRET=

# Realm shown to clients; any stable name works, the domain is customary.
TURN_REALM=camstar.live

# TURN listening port (UDP + TCP must be open).
TURN_LISTEN_PORT=3478

# Relay port range open on the firewall. Each port carries one relayed
# stream; widen if many viewers sit behind CGNAT.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Public IP, required only when the VM's NIC holds a private address
# (AWS/GCP/Azure 1:1 NAT). Leave empty on bare VPS hosts.
TURN_EXTERNAL_IP=
